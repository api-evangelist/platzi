{
  "opencollection": "1.0.0",
  "info": {
    "name": "Platzi Fake Store auth files API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "FilesController_uploadFile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/files/upload"
          }
        },
        {
          "info": {
            "name": "FilesController_seeUploadedFile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/files/:filename",
            "params": [
              {
                "name": "filename",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}